---
import type { EventEntry } from '../utils/events';
import { STATUS_META } from '../utils/events';

interface Props {
  events: EventEntry[];
  currentYear: number;
}

const { events, currentYear } = Astro.props;
// トップページに表示中の年度以外も含めて最大3件をアーカイブ抜粋として表示
const previewEvents = events.filter((e) => e.data.year !== currentYear).slice(0, 3);
const displayEvents = previewEvents.length > 0 ? previewEvents : events.slice(0, 3);
---

<section class="reveal-on-scroll bg-amber-50/60 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <span class="inline-block rounded-full bg-sky-100 px-4 py-1 text-xs font-bold tracking-wider text-sky-900">
          ARCHIVE
        </span>
        <h2 class="font-display mt-3 text-3xl font-black text-ink sm:text-4xl">
          開催履歴・アーカイブ
        </h2>
        <p class="mt-2 text-sm text-slate-600 sm:text-base">
          これまでの「〇〇わんぱーく」の開催記録や写真レポートをご覧いただけます。
        </p>
      </div>
      <a
        href="/archive"
        class="font-display inline-flex items-center gap-1.5 rounded-full border-2 border-amber-300 bg-white px-5 py-2.5 text-sm font-bold text-ink transition hover:border-coral hover:text-coral"
      >
        すべての開催履歴を見る
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        displayEvents.map((item) => {
          const status = STATUS_META[item.data.status];
          return (
            <a
              href={`/archive/${item.data.year}`}
              class="group flex flex-col justify-between rounded-3xl border border-amber-200 bg-white p-6 shadow-xs transition hover:-translate-y-1 hover:border-coral/60 hover:shadow-md"
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="font-display text-2xl font-black text-coral">{item.data.year}年</span>
                  <span class={`rounded-full border px-3 py-0.5 text-xs font-bold ${status.badgeClass}`}>
                    {status.label}
                  </span>
                </div>
                <h3 class="font-display mt-3 text-lg font-bold text-ink group-hover:text-coral">
                  {item.data.title}
                </h3>
                <p class="mt-1 text-xs font-medium text-slate-500">{item.data.date}</p>
                <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-slate-600">
                  {item.data.summary}
                </p>
              </div>

              <div class="mt-5 flex items-center justify-between border-t border-amber-100 pt-4 text-xs font-bold text-coral">
                <span>詳細・レポートを見る</span>
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
                  →
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
