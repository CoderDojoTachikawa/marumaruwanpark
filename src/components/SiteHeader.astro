---
import { siteConfig } from '../config/site';

interface Props {
  /** トップページ以外のページではセクションリンクを /#section にする */
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const prefix = isHome ? '' : '/';

const navItems = [
  { label: 'イベント概要', href: `${prefix}#about` },
  { label: 'プログラム', href: `${prefix}#programs` },
  { label: 'アクセス', href: `${prefix}#access` },
  { label: 'Q&A', href: `${prefix}#faq` },
  { label: '過去の開催', href: '/archive' },
  { label: 'お問い合わせ', href: `${prefix}#contact` },
];
---

<header class="sticky top-0 z-40 border-b border-amber-200/80 bg-cream/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a
      href="/"
      class="group flex items-center gap-2.5 rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-coral"
    >
      <span
        class="flex h-10 w-10 items-center justify-center rounded-2xl bg-gradient-to-br from-sunny to-coral text-lg font-bold text-white shadow-sm transition-transform group-hover:rotate-6"
        aria-hidden="true"
      >
        〇〇
      </span>
      <div class="leading-tight">
        <span class="font-display block text-lg font-extrabold tracking-tight text-ink sm:text-xl">
          {siteConfig.siteName}
        </span>
        <span class="hidden text-[11px] font-medium text-slate-500 sm:block">
          {siteConfig.venue.name}
        </span>
      </div>
    </a>

    <!-- PC用ナビゲーション -->
    <nav aria-label="メインメニュー" class="hidden items-center gap-1 md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-full px-3.5 py-2 text-sm font-bold text-slate-700 transition-colors hover:bg-amber-100/80 hover:text-coral"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- スマホ用メニューボタン -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-amber-200 bg-white text-slate-700 shadow-xs transition hover:bg-amber-50 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="メニューを開く"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- スマホ用ドロップダウンメニュー -->
  <nav
    id="mobile-menu"
    aria-label="モバイルメニュー"
    class="hidden border-t border-amber-200/70 bg-white/95 px-4 py-3 md:hidden"
  >
    <ul class="flex flex-col gap-1">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-nav-link block rounded-xl px-4 py-2.5 text-base font-bold text-slate-700 transition hover:bg-amber-50 hover:text-coral"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden', isOpen);
      toggleBtn.setAttribute('aria-expanded', String(!isOpen));
      toggleBtn.setAttribute('aria-label', isOpen ? 'メニューを開く' : 'メニューを閉じる');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.setAttribute('aria-label', 'メニューを開く');
      });
    });
  }
</script>
