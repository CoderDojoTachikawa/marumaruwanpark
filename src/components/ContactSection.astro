---
import { siteConfig } from '../config/site';
---

<section id="contact" class="reveal-on-scroll py-16 sm:py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <div class="rounded-[2rem] border-2 border-amber-200 bg-gradient-to-br from-sunny/25 via-white to-sky-100/40 p-8 text-center shadow-sm sm:p-12">
      <span class="inline-block rounded-full bg-white px-4 py-1 text-xs font-bold tracking-wider text-coral shadow-2xs">
        CONTACT
      </span>
      <h2 class="font-display mt-3 text-3xl font-black text-ink sm:text-4xl">
        お問い合わせ
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-slate-600 sm:text-base">
        イベントへのご質問、団体出展やワークショップ企画のご相談、当日運営ボランティアのご連絡は、下記メールアドレスまでお気軽にお問い合わせください。
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        {
          siteConfig.contactEmail ? (
            <a
              href={`mailto:${siteConfig.contactEmail}`}
              class="font-display inline-flex items-center gap-2 rounded-full bg-coral px-7 py-3.5 text-base font-bold text-white shadow-md transition hover:-translate-y-0.5 hover:bg-orange-600"
            >
              メールでお問い合わせ
              <span aria-hidden="true">✉</span>
            </a>
          ) : (
            siteConfig.socialLinks.map((sns) => (
              <a
                href={sns.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-display inline-flex items-center gap-2 rounded-full bg-coral px-6 py-3 text-sm font-bold text-white shadow-md transition hover:-translate-y-0.5 hover:bg-orange-600"
              >
                {sns.label} で問い合わせる
                <span aria-hidden="true">↗</span>
              </a>
            ))
          )
        }
      </div>
      <p class="mt-3 text-xs font-bold text-slate-500">
        {
          siteConfig.contactEmail
            ? `宛先: ${siteConfig.contactEmail}（${siteConfig.organizerName}）`
            : `運営: ${siteConfig.organizerName}`
        }
      </p>
    </div>
  </div>
</section>
