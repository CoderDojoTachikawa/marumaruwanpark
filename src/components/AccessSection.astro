---
import { siteConfig } from '../config/site';

const { venue } = siteConfig;
---

<section id="access" class="reveal-on-scroll py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <span class="inline-block rounded-full bg-emerald-100 px-4 py-1 text-xs font-bold tracking-wider text-emerald-900">
        ACCESS
      </span>
      <h2 class="font-display mt-3 text-3xl font-black text-ink sm:text-4xl">
        会場・アクセス
      </h2>
    </div>

    <div class="mt-10 grid items-stretch gap-8 lg:grid-cols-2">
      <div class="flex flex-col justify-between rounded-3xl border border-amber-200 bg-white p-6 shadow-sm sm:p-8">
        <div>
          <h3 class="font-display text-2xl font-bold text-ink">{venue.name}</h3>
          <p class="mt-2 text-sm font-medium text-slate-600">
            {venue.postalCode} {venue.address}
          </p>

          <h4 class="font-display mt-6 text-sm font-bold text-slate-500">交通アクセス</h4>
          <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-slate-700">
            {
              venue.access.map((line) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-meadow" aria-hidden="true" />
                  <span>{line}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={venue.mapExternalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-display inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-bold text-white transition hover:bg-slate-700"
          >
            Googleマップで開く
            <span aria-hidden="true">↗</span>
          </a>
          <a
            href={venue.officialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-display inline-flex items-center gap-2 rounded-full border-2 border-amber-200 bg-white px-5 py-2.5 text-sm font-bold text-ink transition hover:border-coral hover:text-coral"
          >
            施設公式サイト
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Googleマップ埋め込み枠 -->
      <div class="min-h-[320px] overflow-hidden rounded-3xl border border-amber-200 bg-amber-50 shadow-sm">
        <iframe
          title={`${venue.name}の地図`}
          src={venue.mapEmbedUrl}
          class="h-full min-h-[320px] w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
