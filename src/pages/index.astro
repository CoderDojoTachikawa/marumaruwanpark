---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ProgramList from '../components/ProgramList.astro';
import ArchivePreviewSection from '../components/ArchivePreviewSection.astro';
import AccessSection from '../components/AccessSection.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import ContactSection from '../components/ContactSection.astro';
import { siteConfig } from '../config/site';
import { buildEventJsonLd, getAllEventsSorted, getFeaturedEvent } from '../utils/events';

const featuredEvent = await getFeaturedEvent();
const allEvents = await getAllEventsSorted();
const { data } = featuredEvent;

const pageUrl = new URL('/', Astro.site ?? Astro.url.origin).toString();
const eventJsonLd = buildEventJsonLd(featuredEvent, pageUrl);

const pageTitle = `${data.title}｜${siteConfig.venue.name}の体験型あそびイベント`;
---

<BaseLayout title={pageTitle} description={data.summary} isHome={true} jsonLd={eventJsonLd}>
  <!-- ヒーローセクション -->
  <HeroSection event={featuredEvent} />

  <!-- イベント概要セクション -->
  <section id="about" class="reveal-on-scroll py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="rounded-[2rem] border-2 border-amber-200 bg-white p-7 shadow-sm sm:p-10">
        <div class="text-center">
          <span class="inline-block rounded-full bg-orange-100 px-4 py-1 text-xs font-bold tracking-wider text-orange-900">
            ABOUT
          </span>
          <h2 class="font-display mt-3 text-3xl font-black text-ink sm:text-4xl">
            {siteConfig.siteName}ってどんなイベント？
          </h2>
        </div>

        <p class="mt-6 text-base leading-loose text-slate-700 sm:text-lg">
          {data.summary}
        </p>

        {
          data.highlights.length > 0 && (
            <ul class="mt-6 grid gap-3 sm:grid-cols-3">
              {data.highlights.map((item) => (
                <li class="rounded-2xl bg-amber-50/80 p-4 text-sm font-bold leading-relaxed text-amber-950">
                  {item}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </section>

  <!-- 参加団体・プログラム紹介（エリア別フィルター付き） -->
  <ProgramList programs={data.programs} year={data.year} />

  <!-- 過去の開催アーカイブ抜粋 -->
  <ArchivePreviewSection events={allEvents} currentYear={data.year} />

  <!-- 会場・アクセス -->
  <AccessSection />

  <!-- よくある質問（アコーディオン） -->
  <FaqAccordion faqs={data.faqs} />

  <!-- お問い合わせ導線 -->
  <ContactSection />
</BaseLayout>
