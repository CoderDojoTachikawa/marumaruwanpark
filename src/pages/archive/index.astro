---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import { getAllEventsSorted, STATUS_META } from '../../utils/events';

const events = await getAllEventsSorted();
const pageTitle = `過去の開催履歴・アーカイブ｜${siteConfig.siteName}`;
const pageDescription = `${siteConfig.venue.name}で開催してきた「${siteConfig.siteName}」の年度別開催記録・プログラム・写真ギャラリー一覧です。`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="bg-gradient-to-b from-amber-50 to-cream py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 text-center sm:px-6">
      <span class="inline-block rounded-full bg-sky-100 px-4 py-1 text-xs font-bold tracking-wider text-sky-900">
        ARCHIVE
      </span>
      <h1 class="font-display mt-3 text-3xl font-black text-ink sm:text-5xl">
        開催履歴アーカイブ
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
        立川市子ども未来センターで開催してきた「{siteConfig.siteName}」の年度ごとの開催概要・実施プログラム・写真レポートをまとめています。
      </p>
    </div>
  </section>

  <section class="pb-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid gap-6 md:grid-cols-2">
        {
          events.map((event) => {
            const { data } = event;
            const status = STATUS_META[data.status];
            return (
              <a
                href={`/archive/${data.year}`}
                class="group flex flex-col justify-between rounded-3xl border-2 border-amber-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-coral hover:shadow-md sm:p-7"
              >
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-display text-3xl font-black text-coral">{data.year}</span>
                    <span class={`rounded-full border px-3.5 py-1 text-xs font-bold ${status.badgeClass}`}>
                      {status.label}
                    </span>
                  </div>

                  <h2 class="font-display mt-3 text-xl font-bold text-ink group-hover:text-coral">
                    {data.title}
                  </h2>
                  <p class="mt-1 text-xs font-medium text-slate-500">
                    {data.date} ／ {data.fee}
                  </p>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600">
                    {data.summary}
                  </p>

                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {data.themeKeywords.map((kw) => (
                      <span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-bold text-amber-900">
                        #{kw}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="mt-6 flex items-center justify-between border-t border-amber-100 pt-4 text-sm font-bold text-coral">
                  <span>
                    プログラム（{data.programs.length}件）・写真（{data.gallery.length}枚）
                  </span>
                  <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
                    →
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
